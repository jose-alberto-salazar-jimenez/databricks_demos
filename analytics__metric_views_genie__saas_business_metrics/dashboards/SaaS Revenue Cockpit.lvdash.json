{
  "datasets": [
    {
      "name": "revenue",
      "displayName": "Revenue metrics (certified)",
      "asset_name": "saas_demo.gold.saas_revenue_metrics"
    },
    {
      "name": "customers",
      "displayName": "Customer metrics (certified)",
      "asset_name": "saas_demo.gold.saas_customer_metrics"
    },
    {
      "name": "cohorts",
      "displayName": "Cohort retention",
      "config": {
        "version": "1.1",
        "source": "saas_demo.gold.cohort_retention",
        "dimensions": [
          {
            "name": "signup_month",
            "expr": "signup_month"
          },
          {
            "name": "months_since_signup",
            "expr": "months_since_signup"
          }
        ],
        "measures": [
          {
            "name": "logo_retention",
            "expr": "SUM(customers_active) / SUM(customers_start)",
            "comment": "Customers still active / customers at signup, pooled over the cohorts in scope.",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "revenue_retention",
            "expr": "SUM(mrr_now) / SUM(mrr_start)",
            "comment": "Cohort MRR now / cohort MRR at the end of the signup month, pooled over the cohorts in scope.",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "cohorts_in_scope",
            "expr": "COUNT(DISTINCT signup_month)"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "cockpit",
