              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "frame": {
                "title": "MRR (last complete month)",
                "showTitle": true
              },
              "encodings": {
                "value": {
                  "fieldName": "mrr",
                  "displayName": "MRR",
                  "format": {
                    "type": "number-currency",
                    "currencyCode": "USD",
                    "abbreviation": "compact",
                    "decimalPlaces": {
                      "type": "max",
                      "places": 2
                    }
                  }
                }
              },
              "data": {
                "queryName": "main"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 2,
            "height": 3
